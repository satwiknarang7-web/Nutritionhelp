# --- Database (Neon) ---
# Use the *pooled* connection string from the Neon console (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/nutritrack?sslmode=require&channel_binding=require

# Secret used to encrypt users' own Gemini API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Public URL of the app, used in email links (defaults to the request URL)
# APP_BASE_URL=https://nutritrack.example.com

# --- Email (verification + password reset). Any SMTP provider works. ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=NutriTrack <you@gmail.com>
# REQUIRE_EMAIL_VERIFICATION=false

# --- AI food recognition (all optional) ---
# Users can add their own Gemini key in Profile; it always takes priority.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=

# --- External food databases (on by default) ---
# USDA_API_KEY=DEMO_KEY   # free key: https://fdc.nal.usda.gov/api-key-signup

# Optional: Redis for shared caching across workers. Falls back to in-memory cache when unset.
# REDIS_URL=redis://localhost:6379/0

# Set to false only for local http:// development
COOKIE_SECURE=true
# APP_ENV=development     # logs email links when SMTP is not configured
