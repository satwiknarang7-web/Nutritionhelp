# NutriTrack configuration
# Copy this file to .env and fill in the values. Leave anything optional blank to use the default.

# ---------- Required ----------
# Neon console -> your project -> Connect -> pooled connection string
DATABASE_URL=
# Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ---------- App ----------
# Public URL, e.g. https://nutritrack.example.com (used in email links)
APP_BASE_URL=
# Set to false only when running locally over plain http
COOKIE_SECURE=
# "development" logs email links when SMTP is not set up
APP_ENV=

# ---------- Email: password reset + confirmation ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# e.g. NutriTrack <you@gmail.com>
SMTP_FROM=
# true = users must confirm their email before signing in
REQUIRE_EMAIL_VERIFICATION=

# ---------- AI food recognition (optional) ----------
# App-wide fallbacks; users can also add their own Gemini key in Profile.
# Leave GEMINI_MODEL blank to automatically use the newest stable Gemini Flash model.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# ---------- Food databases (optional) ----------
# Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# ---------- Caching (optional) ----------
REDIS_URL=
