# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Secret used to encrypt users' own Gemini API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- AI food recognition (all optional) ---
# Users can add their own Gemini key in Settings; it always takes priority.
# Server-wide fallbacks used when a user has not added a key:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=

# External food databases (on by default). Get a free USDA key at https://fdc.nal.usda.gov/api-key-signup
# USDA_API_KEY=DEMO_KEY
# ENABLE_OPENFOODFACTS=true
# ENABLE_USDA=true

# Optional: Redis for shared caching across workers. Falls back to in-memory cache when unset.
# REDIS_URL=redis://localhost:6379/0

# Set to false only for local http:// development
COOKIE_SECURE=true
